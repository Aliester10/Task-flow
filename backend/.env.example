# --- DATABASE ---
# Development lokal: PostgreSQL dari container (docker compose up db)
# Port host 5433 → container 5432 (lihat docker-compose.yml)
DATABASE_URL="postgresql://taskflow_user:taskflow_password@localhost:5433/taskflow_db"

# URL direct untuk prisma migrate / prisma studio.
# Di setup container sendiri (tanpa pooler), nilainya sama dengan DATABASE_URL.
DIRECT_URL="postgresql://taskflow_user:taskflow_password@localhost:5433/taskflow_db"

# --- AUTH ---
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

# --- SERVER ---
PORT=5000

# ⚠️ WAJIB diisi di environment production:
# - NODE_ENV=production mengaktifkan scheduleCleanup() otomatis (activity_logs & notifications)
# - Tanpa ini cleanup tidak akan pernah jalan meski server berjalan normal
# - Nilai: development | production
NODE_ENV=development

FRONTEND_URL="http://localhost:5173"

# CATATAN: Saat berjalan di dalam container (docker compose up), semua variabel
# di atas di-inject dari docker-compose.yml — file .env ini hanya untuk
# development lokal di luar container.
