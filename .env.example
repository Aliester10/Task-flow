# ─── Docker Compose Environment ───────────────────────────────────────────
# Salin file ini menjadi .env lalu sesuaikan nilainya:
#   cp .env.example .env
# Di VPS, file .env WAJIB ada di /srv/docker/apps/taskflow (dikelola manual, bukan dari git).

# --- DATABASE (MENUMPANG PostgreSQL utama server) ---
# Admin server sudah menyiapkan database terisolasi + role khusus untuk TaskFlow.
# Backend TIDAK menjalankan container DB sendiri di produksi; ia terhubung ke
# Postgres utama (host `postgres`) lewat network `web`.
# Isi PASSWORD asli dari admin di file .env VPS — JANGAN commit ke git.
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=<isi-password-dari-admin-server>
POSTGRES_DB=taskflow

# Hostname/nama container Postgres utama (resolusi DNS di network `web`).
DB_HOST=postgres
# Port internal Postgres di network (umumnya 5432)
DB_PORT=5432

# CATATAN: database & role sudah disiapkan admin di Postgres utama, jadi tidak
# perlu membuatnya lagi. Backend cukup di-attach ke network `web` (lihat compose).

# --- AUTH ---
# WAJIB diganti di production! Generate dengan: openssl rand -base64 32
JWT_SECRET=ganti-dengan-secret-acak-yang-panjang
JWT_EXPIRES_IN=7d

# --- APP ---
# Origin publik aplikasi — untuk CORS & Socket.IO backend.
# Production (via Traefik): https://taskflow.aliester.dev
FRONTEND_URL=https://taskflow.aliester.dev

# ═══════════════════════════════════════════════════════════════════════════
# DEV LOKAL SAJA (dipakai docker-compose.override.yml) — timpa nilai di atas:
#   POSTGRES_USER=taskflow
#   POSTGRES_PASSWORD=rahasia123
#   POSTGRES_DB=taskflow
#   DB_HOST=db                     # nama service Postgres lokal di override
#   FRONTEND_URL=http://localhost:8080
# Prasyarat dev: docker network create web
# APP_PORT = port publik nginx frontend saat dev di localhost.
APP_PORT=8080
