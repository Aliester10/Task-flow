# ─── Docker Compose Environment ───────────────────────────────────────────
# Salin file ini menjadi .env lalu sesuaikan nilainya:
#   cp .env.example .env
# Di VPS, file .env WAJIB ada di /srv/docker/apps/taskflow (dikelola manual, bukan dari git).

# --- DATABASE (MENUMPANG PostgreSQL utama server) ---
# Kredensial diberikan oleh admin server. TaskFlow tidak menjalankan container DB
# sendiri di produksi; backend terhubung ke Postgres utama lewat network bersama.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<isi-password-dari-admin-server>
# Database khusus TaskFlow di dalam Postgres utama (harus sudah dibuat, lihat catatan di bawah)
POSTGRES_DB=taskflow_db

# Hostname/nama container Postgres utama (resolusi DNS di dalam Docker network).
# TANYAKAN ke admin server. Contoh: postgres / main_db / db
DB_HOST=<nama-container-postgres-utama>
# Port internal Postgres di network (umumnya 5432)
DB_PORT=5432
# Nama Docker network bersama tempat Postgres utama berada.
# TANYAKAN ke admin server. Backend akan join ke network ini.
DB_NETWORK=<nama-network-bersama-db>

# CATATAN: database POSTGRES_DB harus SUDAH ADA di Postgres utama sebelum deploy,
# karena `prisma migrate deploy` tidak membuat database. Minta admin menjalankan
# (sekali saja):  CREATE DATABASE taskflow_db;

# --- AUTH ---
# WAJIB diganti di production! Generate dengan: openssl rand -base64 32
JWT_SECRET=ganti-dengan-secret-acak-yang-panjang
JWT_EXPIRES_IN=7d

# --- APP ---
# Origin publik aplikasi — untuk CORS & Socket.IO backend.
# Production (via Traefik): https://taskflow.aliester.dev
FRONTEND_URL=https://taskflow.aliester.dev

# ═══════════════════════════════════════════════════════════════════════════
# DEV LOKAL SAJA (dipakai docker-compose.override.yml) — timpa nilai di atas:
#   POSTGRES_USER=taskflow_user
#   POSTGRES_PASSWORD=rahasia123
#   POSTGRES_DB=taskflow_db
#   DB_HOST=db                     # nama service Postgres lokal di override
#   DB_NETWORK=taskflow_local_db   # buat: docker network create taskflow_local_db
#   FRONTEND_URL=http://localhost:8080
# APP_PORT = port publik nginx frontend saat dev di localhost.
APP_PORT=8080
